[Unit]
Description=pilights Christmas light controller
After=sound.target pilights-ir-keymap.service

[Service]
User=@USER@
WorkingDirectory=@DIR@
SupplementaryGroups=audio
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStartPre=-/bin/sh -c '[ -z "@BT@" ] || { bluetoothctl connect @BT@; sleep 5; }'
ExecStart=@UV@ run --frozen --extra pi pilights play --loop --active-low --remote --device pipewire --start-paused --watch @DIR@/examples
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
